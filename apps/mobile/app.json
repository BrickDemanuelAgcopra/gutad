{
  "expo": {
    "name": "Gutad",
    "slug": "gutad",
    "version": "1.0.0",
    "scheme": "gutad",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.gutad.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to find restaurants near you and to track deliveries you are driving.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.gutad.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#f45d0a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gutad uses your photos for your chef portrait, dish photos and documents you choose to upload.",
          "cameraPermission": "Gutad uses the camera to photograph permits, certificates and dishes you choose to upload."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 160,
          "backgroundColor": "#f45d0a"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to find nearby restaurants and for driver navigation."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f45d0a",
          "sounds": ["./assets/sounds/new_order.wav"]
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://api.gutad.io",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4adfd5f8-e1e7-4dad-bd25-526c2ff43739"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "brickagcopra"
  }
}
