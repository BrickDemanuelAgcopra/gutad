# ---------- Gutad environment (copy to .env on the VPS) ----------
NODE_ENV=production
DOMAIN=gutad.io
API_DOMAIN=api.gutad.io
PUBLIC_WEB_URL=https://gutad.io
PUBLIC_API_URL=https://api.gutad.io
ACME_EMAIL=admin@gutad.io

# Postgres (docker service "postgres")
POSTGRES_USER=gutad
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=gutad
DATABASE_URL=postgresql://gutad:change-me-strong@postgres:5432/gutad?schema=public

# Redis (docker service "redis")
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-64-random-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30

# Initial platform administrator (created by seed if absent)
ADMIN_EMAIL=admin@gutad.io
ADMIN_PASSWORD=change-me-admin

# Payments: "mock" (no external calls) or "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_BPS=0

# Delivery: "mock", "doordash" (Drive) or "uber" (Direct)
DELIVERY_PROVIDER=mock
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Messaging: "log" (write to outbox only), "twilio", "smtp"
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM=no-reply@gutad.io

# Push (Expo push service) — leave empty to disable
EXPO_ACCESS_TOKEN=

# Maps / geocoding: "mock" or "google"
GEOCODER_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Object storage (S3-compatible, optional). Empty = local disk volume
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Platform economics defaults (basis points, cents)
DEFAULT_MARKETPLACE_COMMISSION_BPS=1500
DEFAULT_DIRECT_PROCESSING_BPS=295
DEFAULT_DIRECT_PROCESSING_FIXED_CENTS=29
DEFAULT_COVER_FEE_CENTS=150
DEFAULT_PREPAID_EXPERIENCE_FEE_BPS=200
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=America/New_York
